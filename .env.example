# Rackbase IT Inventory System - Environment Configuration
# Copy this file to .env and customize the values

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# Secret key for JWT token generation and encryption
# IMPORTANT: Change this to a random string in production!
# A secret key will automatically be generated and saved to '.secret_key' if left blank 
SECRET_KEY=

# JWT token expiration time (in minutes)
# Default: 60 minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================================================
# SERVER SETTINGS
# ============================================================================

# Host/IP address to bind the backend server
# Options:
#   - 127.0.0.1    : Only accessible from this computer (default, secure)
#   - 0.0.0.0      : Accessible from any network interface (use with caution)
#   - 192.168.x.x  : Specific IP on your network
#   - localhost    : Same as 127.0.0.1
BACKEND_HOST=127.0.0.1

# Port for the backend API server
# Default: 8088
# Change if port is already in use
BACKEND_PORT=8088

# ============================================================================
# FRONTEND SETTINGS
# ============================================================================

# Host/IP address to bind the frontend development server
# Options:
#   - 127.0.0.1    : Only accessible from this computer (secure, default)
#   - 0.0.0.0      : Accessible from any network interface (allows other devices)
#   - localhost    : Same as 127.0.0.1
FRONTEND_HOST=0.0.0.0

# Port for the frontend Next.js development server
# Default: 3306
# Change if port is already in use
FRONTEND_PORT=3036

# Backend API URL that the frontend will connect to
# Format: http://HOST:PORT
# Default: http://localhost:8088
# If you change BACKEND_HOST above, update this too!
NEXT_PUBLIC_API_URL=http://localhost:8088

# ============================================================================
# DATABASE SETTINGS
# ============================================================================

# Database connection URL
# SQLite (default - file-based, no server needed):
DATABASE_URL=sqlite:///./rackbase.db

# PostgreSQL (uncomment to use instead of SQLite):
# DATABASE_URL=postgresql://username:password@localhost:5432/rackbase

# MySQL (uncomment to use):
# DATABASE_URL=mysql://username:password@localhost:3306/rackbase

# ============================================================================
# FILE STORAGE SETTINGS
# ============================================================================

# Directory for uploaded files (relative to project root)
# Default: ./uploads
UPLOAD_DIR=./uploads

# Maximum file upload size in bytes
# Default: 10 MB (10485760 bytes)
MAX_UPLOAD_SIZE=10485760

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/disable user registration (set to false to disable new signups)
# Default: true
ALLOW_REGISTRATION=true

# Enable/disable debug mode (shows detailed error messages)
# Default: false
DEBUG=false

# Enable/disable audit logging
# Default: true
ENABLE_AUDIT_LOG=true

# ============================================================================
# CORS SETTINGS (Advanced)
# ============================================================================

# Comma-separated list of allowed origins for CORS
# Used for cross-origin requests from the frontend
# Default allows common localhost ports
CORS_ORIGINS=http://localhost:3306,http://127.0.0.1:3306,http://localhost:3000,http://127.0.0.1:3000

# ============================================================================
# BACKUP SETTINGS
# ============================================================================

# Directory for database backups
# Default: ./backups
BACKUP_DIR=./backups

# Auto-backup interval in hours (0 to disable)
# Default: 24 (daily backups)
AUTO_BACKUP_INTERVAL_HOURS=24

# Number of backup files to keep (older ones are deleted)
# Default: 7
MAX_BACKUP_COUNT=7

# ============================================================================
# EMAIL SETTINGS (Optional - for notifications)
# ============================================================================

# SMTP server for sending email notifications
# Leave blank to disable email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@rackbase.local

# ============================================================================
# SSL/TLS SETTINGS (Production)
# ============================================================================

# Path to SSL certificate file (for HTTPS)
# Leave blank to use HTTP
SSL_CERT_FILE=

# Path to SSL private key file
SSL_KEY_FILE=

# ============================================================================
# QUICK START GUIDE
# ============================================================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Edit the values you want to change (at minimum, change SECRET_KEY)
#
# 3. Start the backend (it will read these settings automatically):
#    uvicorn main:app --reload
#
# 4. Start the frontend:
#    cd frontend && npm run dev
#
# 5. Access the application at http://localhost:FRONTEND_PORT
#
# ============================================================================
# EXAMPLE CONFIGURATIONS
# ============================================================================
#
# --- Recommended: Secure Setup ---
# Backend on localhost (secure, not exposed to network)
# Frontend on 0.0.0.0 (accessible from other devices on your network)
# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=8088
# FRONTEND_HOST=0.0.0.0
# FRONTEND_PORT=3306
# NEXT_PUBLIC_API_URL=http://localhost:8088
#
# --- Local Only (most secure) ---
# Both backend and frontend only on this computer
# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=8088
# FRONTEND_HOST=127.0.0.1
# FRONTEND_PORT=3306
# NEXT_PUBLIC_API_URL=http://localhost:8088
#
# --- Full Network Access ---
# Both backend and frontend accessible from network
# (Use with caution - backend API will be exposed!)
# BACKEND_HOST=0.0.0.0
# BACKEND_PORT=8088
# FRONTEND_HOST=0.0.0.0
# FRONTEND_PORT=3306
# NEXT_PUBLIC_API_URL=http://YOUR_COMPUTER_IP:8088
# CORS_ORIGINS=http://localhost:3306,http://YOUR_COMPUTER_IP:3306
#
# --- Custom Ports (if defaults are taken) ---
# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=9000
# FRONTEND_HOST=0.0.0.0
# FRONTEND_PORT=3001
# NEXT_PUBLIC_API_URL=http://localhost:9000
#
# ============================================================================
